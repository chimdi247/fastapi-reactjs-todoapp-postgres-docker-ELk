# =============================================================================
# Copy to `.env` to override anything. Every value below already has the same
# default inside docker-compose.yml, so `docker compose up -d --build` works
# with no .env at all.
#
# !! These defaults are for LOCAL DEVELOPMENT ONLY. Change every secret before
# !! exposing the stack anywhere else.
# =============================================================================

ENVIRONMENT=local

# ---- Published ports (host) --------------------------------------------------
# Ports bind to localhost only. Set BIND_ADDRESS=0.0.0.0 to reach the stack from
# other machines (and change every default password first!).
# BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
BACKEND_PORT=8085
GRAFANA_PORT=3000
KIBANA_PORT=5601
MAILPIT_UI_PORT=8025
MINIO_CONSOLE_PORT=9001

# ---- PostgreSQL --------------------------------------------------------------
# Note: the password is embedded in DATABASE_URL - URL-encode special characters.
POSTGRES_DB=todos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres

# ---- Backend / auth ----------------------------------------------------------
# >= 32 chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-dev-only-jwt-secret-0123456789abcdef
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=*

# ---- Object storage (MinIO = local S3). For real AWS S3 see observability/README.md
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=password
S3_REGION=us-east-1
MIMIR_BLOCKS_BUCKET=mimir-blocks
MIMIR_RULER_BUCKET=mimir-ruler
MIMIR_ALERTMANAGER_BUCKET=mimir-alertmanager
ES_SNAPSHOT_BUCKET=es-log-archive

# ---- Elasticsearch / Kibana --------------------------------------------------
ELASTIC_PASSWORD=elastic
KIBANA_SYSTEM_PASSWORD=kibana
# >= 32 chars
KIBANA_ENCRYPTION_KEY=change-me-kibana-encryption-key-0123456789
ES_SNAPSHOT_REPO=s3-logs-archive
# Quartz cron (sec min hour day month dow): hourly by default
ES_SNAPSHOT_CRON=0 0 * * * ?

# ---- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Alerting (Grafana-managed alerts -> e-mail via SMTP) -------------------------
ALERT_CPU_THRESHOLD=40
ALERT_MEMORY_THRESHOLD=40
ALERT_EMAIL_TO=shimdi247@gmail.com

# Default = bundled Mailpit catch-all (read mails at http://localhost:8025).
# Real provider example (Gmail / SES / SendGrid ...):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=app-password  SMTP_STARTTLS_POLICY=MandatoryStartTLS  SMTP_SKIP_VERIFY=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=alerts@todo.com
SMTP_STARTTLS_POLICY=MandatoryStartTLS
SMTP_SKIP_VERIFY=true
